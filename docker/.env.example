# ─── Knowledge Cards Docker paketi ayarları ──────────────────────────
# Bu dosyayı .env olarak kopyala ve şifreleri MUTLAKA değiştir:
#   cp .env.example .env

# Veritabanı şifreleri
DB_ROOT_PASSWORD=degistir-beni-root
DB_PASSWORD=degistir-beni-db

# Nextcloud yönetici hesabı (ilk açılışta otomatik oluşturulur)
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=degistir-beni-admin

# Hangi port'tan erişilecek? → http://localhost:8080
HTTP_PORT=8080

# İzinli alan adları (boşlukla ayrılır). Gerçek alan adın varsa ekle:
#   NC_TRUSTED_DOMAINS=localhost bulut.firma.com
NC_TRUSTED_DOMAINS=localhost
